<view class="register">
  <view class="brand">创建账号</view>
  <view class="brand-sub">注册后即可下单美味蛋糕</view>
  <view class="form">
    <input
      class="ipt"
      type="number"
      placeholder="请输入手机号"
      placeholder-class="ph"
      value="{{phone}}"
      maxlength="11"
      bindinput="onPhone"
    />
    <input
      class="ipt"
      placeholder="设置昵称（选填）"
      placeholder-class="ph"
      value="{{nickname}}"
      bindinput="onNickname"
    />
    <input
      class="ipt"
      type="password"
      placeholder="请输入密码（至少6位）"
      placeholder-class="ph"
      value="{{password}}"
      bindinput="onPassword"
    />
    <input
      class="ipt"
      type="password"
      placeholder="请确认密码"
      placeholder-class="ph"
      value="{{confirmPassword}}"
      bindinput="onConfirmPassword"
    />
    <button class="btn" loading="{{submitting}}" bindtap="doRegister">注 册</button>
    <view class="link" bindtap="goLogin">已有账号？去登录</view>
  </view>
</view>
