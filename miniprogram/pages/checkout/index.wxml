<view class="page">
  <!-- 商品清单 -->
  <view class="section">
    <view class="section-title">商品清单</view>
    <view wx:for="{{items}}" wx:key="cakeId" class="checkout-item">
      <view class="item-left">
        <text class="item-name">{{item.cakeName}}</text>
        <text class="item-amount">x{{item.amount}}</text>
      </view>
      <text class="item-price">¥{{item.price / 100}}</text>
    </view>
  </view>

  <!-- 配送信息 -->
  <view class="section">
    <view class="section-title">配送信息</view>
    <view class="form-item">
      <text class="form-label">配送地址</text>
      <input class="form-input" placeholder="请输入配送地址" value="{{address}}" bindinput="onAddressInput" />
    </view>
    <view class="form-item">
      <text class="form-label">联系电话</text>
      <input class="form-input" type="number" placeholder="请输入联系电话" value="{{phone}}" bindinput="onPhoneInput" />
    </view>
    <view class="form-item">
      <text class="form-label">备注</text>
      <input class="form-input" placeholder="选填，如：少放糖" value="{{remark}}" bindinput="onRemarkInput" />
    </view>
  </view>

  <!-- 支付方式 -->
  <view class="section">
    <view class="section-title">支付方式</view>
    <view class="pay-method">
      <text class="pay-label">余额支付</text>
      <text class="pay-balance">余额：¥{{balance / 100}}</text>
    </view>
  </view>

  <!-- 底部提交栏 -->
  <view class="bottom-bar">
    <view class="total-info">
      <text>合计：</text>
      <text class="total-price">¥{{totalPrice / 100}}</text>
    </view>
    <view class="submit-btn {{submitting ? 'disabled' : ''}}" bindtap="submitOrder">
      {{submitting ? '提交中...' : '提交订单'}}
    </view>
  </view>
</view>
