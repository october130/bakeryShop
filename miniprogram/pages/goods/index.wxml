<view class="page">
  <!-- 顶部购物车入口 -->
  <view class="top-bar">
    <text class="top-title">全部商品</text>
    <view class="cart-icon" bindtap="goCart">
      <text class="cart-emoji">🛒</text>
      <text wx:if="{{cartCount > 0}}" class="cart-badge">{{cartCount > 99 ? '99+' : cartCount}}</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="tip">加载中...</view>
  <view wx:elif="{{error}}" class="tip error">{{error}}</view>
  <block wx:else>
    <view wx:if="{{cakes.length == 0}}" class="tip">暂无商品</view>
    <view wx:else class="goods-grid">
      <view wx:for="{{cakes}}" wx:key="id" class="goods-card" data-id="{{item.id}}" bindtap="goDetail">
        <image wx:if="{{item.image}}" class="goods-img" src="{{item.image}}" mode="aspectFill"></image>
        <view wx:else class="goods-img goods-img-default">
          <text class="goods-img-text">暂无图片</text>
        </view>
        <view class="goods-info">
          <text class="goods-name">{{item.name}}</text>
          <text class="goods-desc">{{item.description}}</text>
          <view class="goods-meta">
            <text class="goods-price">¥{{item.price / 100}}</text>
            <text class="goods-sold">已售 {{item.sold}}</text>
          </view>
        </view>
      </view>
    </view>
  </block>
</view>
